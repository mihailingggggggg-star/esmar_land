# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------
# Meta Pixel id (browser). Leave empty to disable the pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# WhatsApp destination in E.164 digits (default: esmar.kg number)
NEXT_PUBLIC_WHATSAPP_NUMBER=996222111114

# Public origin of this landing (used in canonical urls, CRM payload, CAPI)
PUBLIC_BASE_URL=https://land.esmar.kg

# ---------------------------------------------------------------------------
# Meta Conversions API (server-side)
# ---------------------------------------------------------------------------
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: routes events to Events Manager → Test events
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v23.0
# website for landing events, system_generated for CRM-originated events
META_ACTION_SOURCE_SITE=website
META_ACTION_SOURCE_CRM=system_generated
# Fallback only: send a "Lead" from the landing itself (would duplicate the CRM
# Lead when the CRM integration is live). Keep false in production.
SEND_LEAD_ON_SUBMIT=false

# ---------------------------------------------------------------------------
# CRM (outbound: lead.created webhook)
# ---------------------------------------------------------------------------
# Where new leads are posted, e.g. https://crm.example.kg/api/leads/incoming
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# CRM (inbound: funnel stage → Meta event)
# ---------------------------------------------------------------------------
# Shared secret used to verify x-esmar-signature on /api/crm/lead
CRM_INBOUND_SECRET=

# ---------------------------------------------------------------------------
# Storage (strongly recommended in production)
# ---------------------------------------------------------------------------
# Postgres connection string (Neon / Supabase / RDS). Tables are auto-created.
DATABASE_URL=
DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
ADMIN_TOKEN=
CRON_SECRET=
